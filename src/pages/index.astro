---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import BtnPill from "../components/BtnPill.astro";
import CtaBlock from "../components/CtaBlock.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import workshop from "../assets/images/workshop-over-ai-workflows.jpg";
import agent from "../assets/images/voorbeeld-van-een-ai-content-agent-workflow.jpg";
import panel from "../assets/images/panelgesprek-over-ai.jpg";
import diagram from "../assets/images/diagram-onderzoek-community-poc.jpg";
import poweredBy from "../assets/images/powered-by-howest.png";

const cellSizes = "(max-width: 900px) 100vw, 50vw";
---
<Layout>
  <div class="intro-screen">
    <section class="wrap page-title-row">
      <h1>Eerst vragen.<br /><span class="accent">Dan pas versnellen.</span></h1>
    </section>

    <section class="wrap">
      <div class="intro-box" data-reveal>
        <div class="intro-copy">
          <a class="powered-by" href="https://www.howest.be" target="_blank" rel="noopener noreferrer">
            <Image src={poweredBy} alt="Powered by Howest" width={480} loading="eager" />
          </a>
          <p>We zijn een team van AI-specialisten van Howest, met een stevige achtergrond in business, marketing en IT.</p>
          <p>We helpen organisaties om AI slim en gericht in te zetten. Je krijgt onafhankelijk advies, praktische workshops en concrete prototypes van een academische partner.</p>
        </div>
        <BtnPill href="/aanbod">Ga naar ons aanbod</BtnPill>
      </div>
    </section>
  </div>

  <section class="wrap">
    <div class="testimonials-heading">
      <h2>Ask before you take our word for it.</h2>
      <p class="sub">Bekijk onze testimonials.</p>
    </div>
  </section>

  <TestimonialCarousel />

  <section class="wrap" id="wat-we-doen">
    <h2 class="section-heading">Wat we doen</h2>
    <div class="wwd-grid">
      <div class="wwd-cell photo" data-reveal>
        <Image src={workshop} alt="Workshop over AI-workflows" widths={[480, 800, 1200]} sizes={cellSizes} />
      </div>
      <div class="wwd-cell text" data-reveal>
        <h3>We delen kennis</h3>
        <div class="wwd-body">
          <p>Via onze trajecten, gebaseerd op wetenschappelijk onderzoek, begeleiden we de integratie van AI in de dagelijkse werking van teams en individuen. We bekijken samen de dagelijkse processen van dichtbij en begeleiden je medewerkers van passieve uitvoerders naar bewuste regisseurs.</p>
          <BtnPill href="/aanbod">Ga naar ons aanbod</BtnPill>
        </div>
      </div>

      <div class="wwd-cell text" data-reveal>
        <h3>We maken</h3>
        <div class="wwd-body">
          <p>Kennis krijgt pas waarde in de uitvoering. Op basis van onderzoek en ervaring ontwerpen en bouwen we proof of concepts, tools, AI agents. Altijd menselijk, altijd op maat van je organisatie.</p>
          <BtnPill href="/aanbod">Ga naar ons aanbod</BtnPill>
        </div>
      </div>
      <div class="wwd-cell dark" data-reveal>
        <Image src={agent} alt="Voorbeeld van een AI content agent workflow" widths={[480, 800, 1200]} sizes={cellSizes} />
      </div>

      <div class="wwd-cell photo" data-reveal>
        <Image src={panel} alt="Panelgesprek over AI" widths={[480, 800, 1200]} sizes={cellSizes} />
      </div>
      <div class="wwd-cell text" data-reveal>
        <h3>We onderzoeken</h3>
        <div class="wwd-body">
          <p>Onze basis ligt in toegepast onderzoek vanuit Howest. Via lopende onderzoeksprojecten testen we voortdurend wat écht werkt. Geen vluchtige hypes, wel onderbouwde inzichten die je mensen slimmer, sneller en vaardiger maken.</p>
        </div>
      </div>
    </div>

    <div class="diagram-wrap" data-reveal>
      <Image
        src={diagram}
        alt="Diagram: we onderzoeken, we delen kennis en we maken, rond community, new tech en proof of concepts"
        widths={[640, 1040, 1600]}
        sizes="(max-width: 1040px) 100vw, 1040px"
      />
    </div>
  </section>

  <CtaBlock />
</Layout>
