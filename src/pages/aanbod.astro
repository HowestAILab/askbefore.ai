---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import WatWeDoen from "../components/WatWeDoen.astro";
import CtaBlock from "../components/CtaBlock.astro";
import heroAanbod from "../assets/images/hero-aanbod.png";
import publiek from "../assets/images/publiek-kijkt-naar-presentatie.jpg";
---
<Layout
  title="Aanbod"
  description="Kies hoe je start: AI-implementatie in workflows, met of zonder proof of concepts, of leer agents bouwen met agentic content creation."
>
  <Hero image={heroAanbod} alt="Deelnemers bespreken een workflow met post-its op een houten bord tijdens een workshop" variant="tall">Kies hoe je start.</Hero>

  <section class="wrap">
    <p class="hero-note">AI-tools kennen is één ding, ze slim inzetten een ander. Wat automatiseer je? Wat versterk je? En waar blijft een mens onmisbaar? Met askbefore.ai helpen we je dat concreet te verankeren in je dagelijkse workflows.</p>
  </section>

  <WatWeDoen photo={publiek} photoAlt="Publiek volgt een presentatie op grote schermen tijdens een evenement" />

  <CtaBlock />
</Layout>
