---
// "Boek een verkenningsgesprek" + "Mail ons" call-to-action pair, shared by every page.
import CtaBar from "./CtaBar.astro";
import { SITE } from "../data/site";
---
<div class="cta-row">
  <CtaBar href={SITE.bookingUrl} external pink>Boek een verkenningsgesprek</CtaBar>
  <CtaBar href={`mailto:${SITE.email}`}>Mail naar {SITE.email}</CtaBar>
</div>
