---
import { Image } from "astro:assets";
import logo from "../assets/images/askbefore-ai.png";
import poweredBy from "../assets/images/powered-by-howest.png";
import { NAV } from "../data/site";
---
<header class="site-header" transition:persist>
  <div class="wrap">
    <a class="logo" href="/" aria-label="Askbefore.AI, naar de startpagina">
      <Image src={logo} alt="Askbefore.AI" width={460} loading="eager" />
    </a>
    <nav class="nav-pills" aria-label="Hoofdnavigatie">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="nav-cta nav-howest" href="https://www.howest.be" target="_blank" rel="noopener noreferrer">
      <Image src={poweredBy} alt="Powered by Howest" width={360} loading="eager" />
    </a>
  </div>
</header>
