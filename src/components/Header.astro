---
import { Image } from "astro:assets";
import logo from "../assets/images/askbefore-ai.png";
import { NAV, SITE } from "../data/site";
---
<header class="site-header" transition:persist>
  <div class="wrap">
    <a class="logo" href="/" aria-label="Askbefore.AI, naar de startpagina">
      <Image src={logo} alt="Askbefore.AI" width={460} loading="eager" />
    </a>
    <nav class="nav-pills" aria-label="Hoofdnavigatie">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="nav-cta" href={SITE.bookingUrl} target="_blank" rel="noopener noreferrer" aria-label="Boek een verkenningsgesprek">
      <span class="nav-cta-long">Boek een verkenningsgesprek</span><span class="nav-cta-short" aria-hidden="true">Boek een gesprek</span>
    </a>
  </div>
</header>
