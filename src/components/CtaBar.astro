---
import ArrowIcon from "./ArrowIcon.astro";

interface Props {
  href: string;
  /** Opens in a new tab (booking page). */
  external?: boolean;
  /** Pale purple background with plum text. */
  pink?: boolean;
}
const { href, external = false, pink = false } = Astro.props;
---
<a class:list={["cta-bar", { "is-pink": pink }]} href={href} {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}>
  <span><slot /></span>
  <span class="arrow"><ArrowIcon /></span>
</a>
