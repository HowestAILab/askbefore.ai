---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  variant: "tall" | "short";
}
const { image, alt, variant } = Astro.props;
---
<section class={`hero hero--${variant}`}>
  <div class="wrap">
    <div class="hero-frame">
      <Image
        src={image}
        alt={alt}
        widths={[640, 1024, 1600, 2200]}
        sizes="(max-width: 2200px) 100vw, 2200px"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <h1 class="hero-headline"><slot /></h1>
    </div>
  </div>
</section>
