---
// "AI Transformatietrajecten": a dark bar, then the photo on the left stays in view (sticky)
// while the two blue text blocks on the right scroll past it. See `.traject-split` in global.css.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  photo: ImageMetadata;
  photoAlt: string;
}
const { photo, photoAlt } = Astro.props;

const cellSizes = "(max-width: 900px) 100vw, 50vw";
---
<h3 class="traject-bar" data-reveal>AI Transformatietrajecten</h3>
<div class="traject-split">
  <!-- no data-reveal here: this block is sticky and must not animate its own position -->
  <div class="wwd-cell photo">
    <Image src={photo} alt={photoAlt} widths={[480, 800, 1200]} sizes={cellSizes} />
  </div>

  <div class="wwd-cell text" data-reveal>
    <h4>Wat houdt zo’n traject in?</h4>
    <div class="wwd-body">
      <p class="wwd-lead">Wat automatiseer je? Wat versterk je? Waar blijft een mens onmisbaar? We zoeken het samen uit op drie niveaus:</p>
      <ul class="wwd-list">
        <li><strong>Je mensen:</strong> hoe worden ze nog beter in wat ze al goed doen?</li>
        <li><strong>Je processen:</strong> wat kan vlotter, en wat pak je fundamenteel anders aan?</li>
        <li><strong>Je toekomst:</strong> welk nieuw product of dienst wordt plots haalbaar?</li>
      </ul>
    </div>
  </div>

  <div class="wwd-cell text" data-reveal>
    <h4>Wat mag je verwachten?</h4>
    <div class="wwd-body">
      <p class="wwd-lead">Dit krijg je concreet in handen:</p>
      <ul class="wwd-list">
        <li><strong>Een strategische AI-roadmap.</strong> Een helder stappenplan op maat van jouw organisatie.</li>
        <li><strong>Werkende proof of concepts.</strong> We bouwen en testen tijdens het traject al concrete prototypes en AI-agents op maat.</li>
        <li><strong>Sterk draagvlak.</strong> Een team dat de technologie écht begrijpt en vol vertrouwen zelfstandig verder bouwt aan AI-adoptie.</li>
      </ul>
    </div>
  </div>
</div>
